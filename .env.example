# Smartlead API key (from Smartlead dashboard settings)
SMARTLEAD_API_KEY=your_smartlead_api_key_here

# Optional: Cursor-injected secret name also accepted by the server
# bd7ac1f7-d7ad-4046-a033-fd0ce46e2aa9_l1vmzyk=

# Supabase (for staged lead import tools)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Railway / local port (Railway injects PORT automatically)
PORT=3000
